# Only on the server. Never prefix these variables with VITE_.
ADMIN_PASSWORD=replace-with-your-admin-password
# Generate a random value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
# Required on Vercel. Use the pooled Postgres URL from Neon / another Postgres provider.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Locally, without DATABASE_URL, the app uses data.db (SQLite).
# SQLITE_PATH=data.db
